model EmployeeAddress {
  id              String        @id @default(uuid())
  companyId       String
  userId          String
  label           String
  addressLine1    String
  addressLine2    String?
  city            String
  state           String
  pincode         String
  country         String        @default("IN")
  latitude        Float
  longitude       Float
  landmark        String?
  addressType     String        @default("RESIDENTIAL")
  status          AddressStatus @default(ACTIVE)
  effectiveFrom   DateTime      @default(now())
  effectiveTo     DateTime?
  isDefault       Boolean       @default(false)
  verifiedById    String?
  verifiedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  Company         Company       @relation(fields: [companyId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@index([companyId, userId])
  @@index([companyId, status])
}

model EmployeeSchedule {
  id                    String                    @id @default(uuid())
  companyId             String
  userId                String
  siteId                String?
  effectiveFrom         DateTime
  effectiveTo           DateTime?
  loginTime             String
  logoutTime            String
  loginBuffer           Int                       @default(15)
  logoutBuffer          Int                       @default(15)
  loginArrivalBuffer    Int                       @default(15)
  logoutDepartureBuffer Int                       @default(15)
  slotType              ScheduleSlotType          @default(LOGIN)
  status                ScheduleStatus            @default(ACTIVE)
  isRecurring           Boolean                   @default(true)
  recurringDays         Int[]
  weeklyOffs            WeeklyOffType[]
  nodalPointId          String?
  billingZone           String?
  routeId               String?
  shiftTimingId         String?
  createdBy             String
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  Company               Company                   @relation(fields: [companyId], references: [id])
  user                  User                      @relation(fields: [userId], references: [id])
  nodalPoint            NodalPoint?               @relation(fields: [nodalPointId], references: [id])
  shiftTiming           PickupDropTiming?         @relation(fields: [shiftTimingId], references: [id])
  history               EmployeeScheduleHistory[]
  pickupDrops           AdditionalPickupDrop[]

  @@index([companyId, userId])
  @@index([companyId, effectiveFrom, effectiveTo])
  @@index([companyId, siteId])
  @@index([shiftTimingId])
}

model EmployeeScheduleHistory {
  id          String           @id @default(uuid())
  companyId   String
  scheduleId  String
  userId      String
  changeType  String
  oldValues   Json?
  newValues   Json?
  changedById String
  reason      String?
  createdAt   DateTime         @default(now())
  Company     Company          @relation(fields: [companyId], references: [id])
  schedule    EmployeeSchedule @relation(fields: [scheduleId], references: [id])

  @@index([companyId, scheduleId])
  @@index([companyId, userId])
}

model AdditionalPickupDrop {
  id             String                        @id @default(uuid())
  companyId      String
  userId         String
  scheduleId     String?
  date           DateTime
  pickupDropType PickupDropType                @default(ADDITIONAL)
  addressLine1   String
  addressLine2   String?
  city           String?
  latitude       Float
  longitude      Float
  time           String
  nodalPointId   String?
  billingZone    String?
  remarks        String?
  status         ScheduleStatus                @default(ACTIVE)
  sequenceOrder  Int                           @default(0)
  createdBy      String
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  Company        Company                       @relation(fields: [companyId], references: [id])
  user           User                          @relation(fields: [userId], references: [id])
  schedule       EmployeeSchedule?             @relation(fields: [scheduleId], references: [id])
  nodalPoint     NodalPoint?                   @relation(fields: [nodalPointId], references: [id])
  history        AdditionalPickupDropHistory[]

  @@index([companyId, userId, date])
  @@index([companyId, date, pickupDropType])
}

model AdditionalPickupDropHistory {
  id           String               @id @default(uuid())
  companyId    String
  pickupDropId String
  userId       String
  changeType   String
  oldValues    Json?
  newValues    Json?
  changedById  String
  reason       String?
  createdAt    DateTime             @default(now())
  Company      Company              @relation(fields: [companyId], references: [id])
  pickupDrop   AdditionalPickupDrop @relation(fields: [pickupDropId], references: [id])

