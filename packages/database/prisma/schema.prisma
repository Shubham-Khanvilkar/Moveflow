// OPTIMIZATION SIMULATOR
// ============================================================

model OptimizationSimulator {
  id                   String   @id @default(uuid())
  companyId            String
  siteId               String?
  processId            String?
  scenarioName         String
  status               String   @default("DRAFT") // DRAFT, COMPLETED, APPLIED
  inputConfig          String   @default("{}") // JSON: filters, constraints
  currentVehicles      Int      @default(0)
  currentTrips         Int      @default(0)
  currentEmployees     Int      @default(0)
  currentOccupancy     Float    @default(0)
  currentCostPerDay    Float    @default(0)
  optimizedVehicles    Int      @default(0)
  optimizedTrips       Int      @default(0)
  optimizedOccupancy   Float    @default(0)
  optimizedCostPerDay  Float    @default(0)
  projectedSaving      Float    @default(0)
  projectedSavingPct   Float    @default(0)
  constraints          String?  // JSON: safety rules, female transport, max capacity, etc.
  resultDetails        String?  // JSON: detailed simulation results
  createdBy            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  Company              Company  @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
}

// ============================================================
// DEMAND FORECAST
// ============================================================

model DemandForecast {
  id                   String   @id @default(uuid())
  companyId            String
  siteId               String?
  processId            String?
  shiftCode            String?
  forecastDate         DateTime
  timeSlot30Min        String   // e.g. "08:00-08:30"
  demandType           String   // PICKUP, DROP
  predictedDemand      Int      @default(0)
  actualDemand         Int?
  availableCapacity    Int      @default(0)
  gap                  Int      @default(0) // predicted - capacity
  vehicleUtilization   Float    @default(0)
  modelVersion         String?  // which ML model generated this
  confidence           Float?   // confidence score 0-1
  createdAt            DateTime @default(now())

  @@unique([companyId, siteId, processId, forecastDate, timeSlot30Min, demandType])
  @@index([companyId, forecastDate])
}

// ============================================================
// COST WATERFALL ENTRY
// ============================================================

model CostWaterfallEntry {
  id                   String   @id @default(uuid())
  companyId            String
  period               String   // "2026-09" monthly, "2026-W36" weekly
  periodType           String   @default("MONTHLY") // MONTHLY, WEEKLY, DAILY
  totalTransportCost   Float    @default(0)
  vendorCharges        Float    @default(0)
  driverCharges        Float    @default(0)
  vehicleCharges       Float    @default(0)
  extraTripCharges     Float    @default(0)
  cancellationCharges  Float    @default(0)
  noShowImpact         Float    @default(0)
  savingsApplied       Float    @default(0)
  netTransportCost     Float    @default(0)
  costPerEmployee      Float    @default(0)
  costPerTrip          Float    @default(0)
  costPerKm            Float    @default(0)
  costPerSeat          Float    @default(0)
  breakdown            String?  // JSON: detailed breakdown by site/process/vendor
  createdAt            DateTime @default(now())
  Company              Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, period, periodType])
  @@index([companyId, period])
}

// ============================================================
// VENDOR PERFORMANCE SCORECARD
// ============================================================

model VendorPerformanceScorecard {
  id                   String   @id @default(uuid())
  companyId            String
  vendorId             String
  period               String   // "2026-09"
  totalTrips           Int      @default(0)
  completedTrips       Int      @default(0)
  completionRate       Float    @default(0)
  onTimeRate           Float    @default(0)
  noShowRate           Float    @default(0)
  avgResponseTimeMin   Float    @default(0)
  vehicleUtilization   Float    @default(0)
  slaBreaches          Int      @default(0)
  costPerTrip          Float    @default(0)
  totalEarnings        Float    @default(0)
  penalties            Float    @default(0)
  netEarnings          Float    @default(0)
  safetyIncidents      Int      @default(0)
  avgDriverRating      Float    @default(0)
  createdAt            DateTime @default(now())
  Company              Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, vendorId, period])
  @@index([companyId, period])
  @@index([vendorId])
}

// ============================================================
// VEHICLE OCCUPANCY LOG
// ============================================================

model VehicleOccupancyLog {
  id                   String   @id @default(uuid())
  tripId               String
  vehicleId            String
  companyId            String
  siteId               String?
  processId            String?
  shiftCode            String?
  recordedAt           DateTime @default(now())
  maxCapacity          Int      @default(0)
  occupiedSeats        Int      @default(0)
  occupancyPercent     Float    @default(0)
  isUnderutilized      Boolean  @default(false) // < 40%
  isOptimal            Boolean  @default(false) // 60-85%
  isOverloaded         Boolean  @default(false) // > 100%
  Trip                 Trip?    @relation(fields: [tripId], references: [id])
  Vehicle              Vehicle  @relation(fields: [vehicleId], references: [id])
  Company              Company  @relation(fields: [companyId], references: [id])

  @@index([companyId, recordedAt])
  @@index([vehicleId, recordedAt])
  @@index([tripId])
}

// ============================================================
// APPROVAL WORKFLOW (FOUR-EYES / MAKER-CHECKER)
// ============================================================

model ApprovalRequest {
  id             String          @id @default(uuid())
  companyId      String
  entityType     String          // RATE_CARD | VENDOR_INVOICE | ROLE_CHANGE | COMPANY_SETUP | SITE_CREATE | POLICY_CHANGE | LOCATION_CHANGE
  entityId       String
  action         String          // CREATE | UPDATE | DELETE | ACTIVATE | DEACTIVATE
  requestedBy    String
  approvedBy     String?
  status         ApprovalStatus  @default(PENDING)
  reason         String?
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  expiresAt      DateTime?
  Company        Company         @relation(fields: [companyId], references: [id])

  @@index([companyId, entityType, status])
  @@index([requestedBy])
  @@index([approvedBy])
}

// ============================================================
// LOCATION CHANGE REQUEST
// ============================================================

enum LocationChangeStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

model LocationChangeRequest {
  id               String                @id @default(uuid())
  companyId        String
  employeeId       String
  requestedBy      String
  oldLatitude      Float
  oldLongitude     Float
  oldAddress       String
  newLatitude      Float
  newLongitude     Float
  newAddress       String
  reason           String
  status           LocationChangeStatus  @default(PENDING)
  approvedBy       String?
  approvedAt       DateTime?
  rejectionReason  String?
  effectiveDate    DateTime?
  impactAnalysis   Json?
  distanceChange   Float?
  routeImpact      String?              // LOW | MODERATE | HIGH
  costImpact       Float?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  Company          Company              @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
  @@index([employeeId])
  @@index([requestedBy])
}

model LocationHistory {
  id            String   @id @default(uuid())
  companyId     String
  employeeId    String
  latitude      Float
  longitude     Float
  address       String
  source        String   // INITIAL | APPROVED | MANUAL_OVERRIDE
  approvedBy    String?
  validFrom     DateTime
  validTo       DateTime?
  createdAt     DateTime @default(now())

  @@index([employeeId])
  @@index([companyId, employeeId])
}

// ============================================================
// PERMISSION INHERITANCE TRACKING
// ============================================================

model PermissionInheritance {
  id            String   @id @default(uuid())
  userId        String
  companyId     String
  permissionKey String
  source        String   // ROLE | COMPANY_SCOPE | SITE_SCOPE | PROCESS_SCOPE | INDIVIDUAL_OVERRIDE
  sourceId      String?  // ID of the role/scope/override that provided this permission
  isGranted     Boolean
  hierarchy     Int      // Lower = higher priority (0=override, 1=process, 2=site, 3=company, 4=role)
  createdAt     DateTime @default(now())

  @@unique([userId, companyId, permissionKey, source])
  @@index([userId, companyId])
}

// ============================================================
// INTELLIGENCE LAYER — COST LEAK DETECTION
// ============================================================

enum CostLeakType {
  IDLE_VEHICLE
  LOW_OCCUPANCY
  DUPLICATE_TRIP
  HIGH_EMPTY_KM
  LONG_DETOUR
  EXCESS_VENDOR_CHARGES
  INCORRECT_RATE
  BILLING_MISMATCH
  UNUSUAL_DRIVER_HOURS
  REPEATED_NO_SHOW
  UNDERUSED_SHUTTLE
  REPEATED_CANCELLATION
}

enum CostLeakSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model CostLeak {
  id            String        @id @default(uuid())
  companyId     String
  type          CostLeakType
  severity      CostLeakSeverity
  title         String
  description   String
  estimatedMonthlyImpact Float  // INR
  evidence      Json          // { vehicleId?, tripId?, driverId?, vendorId?, ... }
  status        String        @default("DETECTED") // DETECTED | ACKNOWLEDGED | RESOLVED | DISMISSED
  resolvedBy    String?
  resolvedAt    DateTime?
  detectedAt    DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([companyId, status])
  @@index([companyId, type])
  @@index([companyId, severity])
}

// ============================================================
// INTELLIGENCE LAYER — VENDOR DISCREPANCY TRACKING
// ============================================================

enum DiscrepancyType {
  KM_VARIANCE
  DURATION_VARIANCE
  RATE_VARIANCE
  VEHICLE_UTILIZATION_VARIANCE
  DRIVER_AVAILABILITY_VARIANCE
  INVOICE_VARIANCE
}

model VendorDiscrepancy {
  id              String          @id @default(uuid())
  companyId       String
  vendorId        String
  tripId          String?
  invoiceId       String?
  type            DiscrepancyType
  contractedValue Float           // What contract says
  actualValue     Float           // What GPS/reality shows
  variancePercent Float
  amountAtRisk    Float           // INR
  evidence        Json            // { gpsKm?, invoicedKm?, routeDetails?, ... }
  status          String          @default("DETECTED") // DETECTED | REVIEWING | CONFIRMED | DISPUTED | RESOLVED
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([companyId, vendorId])
  @@index([companyId, status])
}

// ============================================================
// INTELLIGENCE LAYER — PREDICTIVE ANALYTICS
// ============================================================

enum PredictionType {
  NO_SHOW
  BREAKDOWN_RISK
  SLA_RISK
  DEMAND_SPIKE
  DRIVER_UNAVAILABILITY
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model PredictionResult {
  id            String         @id @default(uuid())
  companyId     String
  type          PredictionType
  entityId      String         // employeeId, vehicleId, or tripId
  entityType    String         // EMPLOYEE | VEHICLE | TRIP
  riskScore     Float          // 0-100
  riskLevel     RiskLevel
  factors       Json           // [{ factor, weight, contribution }]
  recommendation String        // Human-readable recommendation
  confidence    Float          // 0-1
  expiresAt     DateTime       // When this prediction becomes stale
  createdAt     DateTime       @default(now())

  @@index([companyId, type, entityType])
  @@index([companyId, entityId])
  @@index([companyId, riskLevel])
}

// ============================================================
// INTELLIGENCE LAYER — CAPACITY EXCHANGE
// ============================================================

model CapacityOpportunity {
  id              String   @id @default(uuid())
  companyId       String
  vehicleId       String
  tripId          String
  availableSeats  Int
  routePolyline   String?  // Encoded route for matching
  pickupLat       Float
  pickupLng       Float
  dropLat         Float
  dropLng         Float
  departureTime   DateTime
  matchedDemand   Json?    // [{ employeeId, routeMatch, deviation, saving }]
  status          String   @default("DETECTED") // DETECTED | MATCHED | ACCEPTED | EXPIRED | DECLINED
  acceptedBy      String?
  acceptedAt      DateTime?
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@index([companyId, status])
  @@index([companyId, tripId])
}

// ============================================================
// INTELLIGENCE LAYER — ROUTE MEMORY
// ============================================================

model RouteMemory {
  id              String   @id @default(uuid())
  companyId       String
  routeKey        String   // Hash of origin+destination+process
  originLat       Float
  originLng       Float
  originAddress   String
  destLat         Float
  destLng         Float
  destAddress     String
  processCode     String?
  historicalData  Json     // { avgDuration, trafficPatterns, bestSequence, frequentDelays, ... }
  tripCount       Int      @default(0)
  avgOccupancy    Float?
  avgDuration     Float?   // minutes
  avgCost         Float?   // INR
  lastUpdated     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([companyId, routeKey])
  @@index([companyId])
}

// ============================================================
// INTELLIGENCE LAYER — TRIP RELIABILITY SCORE
// ============================================================

model TripReliabilityScore {
  id              String   @id @default(uuid())
  companyId       String
  entityId        String   // vehicleId or driverId
  entityType      String   // VEHICLE | DRIVER
  score           Float    // 0-100
  factors         Json     // [{ factor, weight, value }]
  totalTrips      Int
  onTimeTrips     Int
  completedTrips  Int
  cancelledTrips  Int
  noShowTrips     Int
  avgDelayMinutes Float?
  lastCalculated  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, entityId, entityType])
  @@index([companyId, entityType])
}

// ============================================================
// INTELLIGENCE LAYER — EMPLOYEE LOCATION CONFIDENCE
// ============================================================

model EmployeeLocationConfidence {
  id                String   @id @default(uuid())
  companyId         String
  employeeId        String
  score             Float    // 0-100
  factors           Json     // [{ factor, weight, value }]
  gpsPrecision      Float?
  confirmations     Int      @default(0) // Repeated GPS confirmations
  manualCorrections Int      @default(0)
  lastVerified      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([companyId, employeeId])
  @@index([companyId, score])
}

// ============================================================
// CXO ANALYTICS — SLA CONTRACT MANAGEMENT
// ============================================================

model SLADefinition {
  id            String   @id @default(uuid())
  companyId     String
  name          String   // e.g., "Pickup Punctuality", "Emergency Response"
  metric        String   // PUNCTUALITY | EMERGENCY_RESPONSE | GPS_FRESHNESS | MAX_RIDE_TIME | NO_SHOW_RESPONSE
  targetValue   Float    // e.g., 95 (for %), 30 (for seconds), 75 (for minutes)
  targetUnit    String   // PERCENT | SECONDS | MINUTES | COUNT
  scopeType     String   @default("COMPANY") // COMPANY | SITE | PROCESS
  scopeId       String?  // ID of site/process if scoped
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId, isActive])
  @@index([companyId, metric])
}

model SLATrackingRecord {
  id              String   @id @default(uuid())
  companyId       String
  slaDefinitionId String
  period          String   // "2026-09" monthly
  actualValue     Float
  targetValue     Float
  compliancePercent Float
  breachCount     Int      @default(0)
  breachDetails   Json?    // [{ tripId, timestamp, deviation }]
  createdAt       DateTime @default(now())

  @@index([companyId, slaDefinitionId, period])
  @@index([companyId, period])
}

model SLABreachLog {
  id              String   @id @default(uuid())
  companyId       String
  slaDefinitionId String
  entityType      String   // TRIP | VEHICLE | DRIVER | VENDOR
  entityId        String
  targetValue     Float
  actualValue     Float
  deviation       Float
  severity        String   // LOW | MEDIUM | HIGH | CRITICAL
  acknowledgedBy  String?
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([companyId, slaDefinitionId])
  @@index([companyId, severity])
}

// ============================================================
// CXO ANALYTICS — CARBON INTELLIGENCE
// ============================================================

model CarbonFootprintRecord {
  id              String   @id @default(uuid())
  companyId       String
  tripId          String?
  vehicleId       String?
  fuelType        String   // DIESEL | PETROL | CNG | ELECTRIC | HYBRID
  distanceKm      Float
  co2Kg           Float    // CO2 emissions in kg
  co2PerKm        Float    // g CO2/km
  occupancy       Int      @default(1)
  co2PerPassenger Float    // kg CO2 per passenger
  recordedAt      DateTime @default(now())
  period          String   // "2026-09" monthly

  @@index([companyId, period])
  @@index([companyId, vehicleId])
  @@index([companyId, fuelType])
}

model CarbonReductionOpportunity {
  id              String   @id @default(uuid())
  companyId       String
  type            String   // CLUBBING | EV_SWITCH | ROUTE_OPTIMIZATION | VEHICLE_RIGHTSIZING
  description     String
  currentCo2Kg    Float
  potentialCo2Kg  Float
  reductionKg     Float
  reductionPercent Float
  affectedTrips   Int
  estimatedSaving Float?   // INR
  status          String   @default("DETECTED") // DETECTED | ACCEPTED | IMPLEMENTED
  createdAt       DateTime @default(now())

  @@index([companyId, status])
}

// ============================================================
// CXO ANALYTICS — HEALTH SCORE
// ============================================================

model TransportHealthScore {
  id                String   @id @default(uuid())
  companyId         String
  entityType        String   // COMPANY | SITE | PROCESS
  entityId          String
  overallScore      Float    // 0-100
  safetyScore       Float
  reliabilityScore  Float
  utilizationScore  Float
  costEfficiencyScore Float
  vendorQualityScore Float
  gpsHealthScore    Float
  employeeExpScore  Float
  calculatedAt      DateTime @default(now())

  @@unique([companyId, entityType, entityId])
  @@index([companyId, overallScore])
}

// ============================================================
// PLAN 7: PLATFORM SAAS — SUBSCRIPTIONS, WEBHOOKS, SSO
// ============================================================

model SubscriptionPlan {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  description   String?
  tier          String   @default("STARTER") // STARTER, PROFESSIONAL, ENTERPRISE, CUSTOM
  monthlyPrice  Decimal  @db.Decimal(10,2)
  annualPrice   Decimal  @db.Decimal(10,2)
  maxEmployees  Int      @default(100)
  maxVehicles   Int      @default(50)
  maxDrivers    Int      @default(50)
  maxSites      Int      @default(5)
  features      Json     @default("{}")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id                 String    @id @default(uuid())
  companyId          String
  planId             String
  status             String    @default("ACTIVE") // ACTIVE, TRIAL, SUSPENDED, CANCELLED, PAST_DUE
  billingCycle       String    @default("MONTHLY") // MONTHLY, ANNUAL
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  cancelledAt        DateTime?
  suspensionReason   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  company            Company   @relation(fields: [companyId], references: [id])
  plan               SubscriptionPlan @relation(fields: [planId], references: [id])
  usages             SubscriptionUsage[]

  @@index([companyId])
  @@index([status])
}

model SubscriptionUsage {
  id             String   @id @default(uuid())
  subscriptionId String
  metricCode     String   // employees, vehicles, trips, api_calls
  quantity       Int      @default(0)
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId, metricCode])
}

model WebhookConfig {
  id              String   @id @default(uuid())
  companyId       String
  url             String
  secret          String
  events          String[]
  status          String   @default("ACTIVE") // ACTIVE, INACTIVE, FAILED
  failureCount    Int      @default(0)
  lastTriggeredAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  company         Company  @relation(fields: [companyId], references: [id])
  logs            WebhookLog[]

  @@index([companyId, status])
}

model WebhookLog {
  id             String   @id @default(uuid())
  webhookId      String
  event          String
  payload        Json
  responseStatus Int?
  responseBody   String?
  deliveredAt    DateTime @default(now())
  success        Boolean  @default(false)
  webhook        WebhookConfig @relation(fields: [webhookId], references: [id])

  @@index([webhookId, deliveredAt])
}

model SSOConfiguration {
  id           String   @id @default(uuid())
  companyId    String
  provider     String   // OKTA, AZURE_AD, GOOGLE_WORKSPACE, CUSTOM_SAML, CUSTOM_OIDC
  clientId     String
  clientSecret String
  issuerUrl    String
  metadataUrl  String?
  enabled      Boolean  @default(true)
  enforceSSO   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model DataRetentionPolicy {
  id            String   @id @default(uuid())
  companyId     String
  entityType    String   // GPS_POINT, AUDIT_LOG, NOTIFICATION, SESSION
  retentionDays Int      @default(90)
  autoDelete    Boolean  @default(false)
  lastCleanupAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId, entityType])
}

model DSARRequest {
  id          String   @id @default(uuid())
  companyId   String
  userId      String
  requestType String   // ACCESS, DELETION, PORTABILITY, RECTIFICATION
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, REJECTED
  requestedAt DateTime @default(now())
  completedAt DateTime?
  responseUrl String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, userId])
  @@index([status])
}
