generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AIConversation {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, userId])
}

model AIMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String
  content        String?
  toolCalls      Json?
  toolResults    Json?
  tokens         Int?
  model          String?
  provider       String?
  latencyMs      Int?
  costEstimate   Float?
  createdAt      DateTime @default(now())

  @@index([conversationId])
}

model AIUsage {
  id            String   @id @default(uuid())
  companyId     String
  userId        String?
  provider      String
  model         String
  requestType   String
  tokensInput   Int      @default(0)
  tokensOutput  Int      @default(0)
  latencyMs     Int?
  estimatedCost Float?
  success       Boolean  @default(true)
  errorMessage  String?
  createdAt     DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([provider])
}

model AccessScope {
  id        String          @id @default(uuid())
  companyId String
  userId    String
  siteId    String?
  lobId     String?
  processId String?
  shiftId   String?
  isPrimary Boolean         @default(false)
  grantedBy String?
  expiresAt DateTime?
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  Company   Company         @relation(fields: [companyId], references: [id])
  user      User            @relation(name: "AccessScopeUser", fields: [userId], references: [id])
  site      CompanySite?    @relation(name: "AccessScopeSite", fields: [siteId], references: [id])
  lob       LineOfBusiness? @relation(name: "AccessScopeLob", fields: [lobId], references: [id])
  process   OrgProcess?     @relation(name: "AccessScopeProcess", fields: [processId], references: [id])
  shift     Shift?          @relation(name: "AccessScopeShift", fields: [shiftId], references: [id])

  @@unique([userId, siteId, lobId, processId, shiftId])
  @@index([companyId, userId])
  @@index([userId])
}

model AdminDelegation {
  id              String    @id @default(uuid())
  companyId       String
  delegatorUserId String
  delegateUserId  String
  scope           String    @default("COMBINATION")
  siteIds         String[]
  processIds      String[]
  shiftIds        String[]
  permissions     String[]
  reason          String?
  startAt         DateTime
  expiresAt       DateTime
  isActive        Boolean   @default(true)
  revokedAt       DateTime?
  revokedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  Company         Company   @relation(fields: [companyId], references: [id])

  @@index([companyId, delegateUserId])
  @@index([companyId, delegatorUserId])
}

model AdminMFASecret {
  id          String    @id @default(uuid())
  userId      String    @unique
  secret      String
  enabled     Boolean   @default(false)
  backupCodes String[]
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AdminScopeAssignment {
  id               String   @id @default(uuid())
  companyId        String
  userId           String
  assignedByUserId String
  action           String
  previousScope    Json?
  newScope         Json?
  reason           String?
  createdAt        DateTime @default(now())
  Company          Company  @relation(fields: [companyId], references: [id])

  @@index([companyId, userId])
}

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  keyHash    String    @unique
  prefix     String
  companyId  String
  userId     String?
  scopes     String[]  @default([])
  expiresAt  DateTime?
  lastUsedAt DateTime?
  status     String    @default("ACTIVE")
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  Company    Company   @relation(fields: [companyId], references: [id])
  User       User?     @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([keyHash])
}

model ApprovalConfig {
  id            String          @id @default(uuid())
  companyId     String
  level         Int
  approverRole  String?
  departmentId  String?
  serviceType   ServiceType?
  maxAmount     Float?
  ApprovalEntry ApprovalEntry[]

  @@unique([companyId, level])
}

model ApprovalDelegation {
  id          String   @id @default(uuid())
  companyId   String
  delegatorId String
  delegateId  String
  scope       String
  startDate   DateTime
  endDate     DateTime
  active      Boolean  @default(true)
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, delegatorId])
}

model ApprovalEntry {
  id             String              @id @default(uuid())
  bookingId      String
  level          Int
  status         ApprovalEntryStatus @default(PENDING)
  approverId     String?
  configId       String?
  decidedAt      DateTime?
  reason         String?
  createdAt      DateTime            @default(now())
  User           User?               @relation(fields: [approverId], references: [id])
  Booking        Booking             @relation(fields: [bookingId], references: [id])
  ApprovalConfig ApprovalConfig?     @relation(fields: [configId], references: [id])

  @@index([approverId])
  @@index([bookingId])
}

model ApprovalLevel {
  id                      String   @id @default(uuid())
  companyId               String
  workflowType            String
  level                   Int
  approverRole            String
  approverUserIds         String?
  autoApprove             Boolean  @default(false)
  autoApproveAfterMinutes Int?
  isRequired              Boolean  @default(true)
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([companyId, workflowType, level])
  @@index([companyId, workflowType])
}

model ApprovalLevelConfig {
  id                      String               @id @default(uuid())
  companyId               String
  workflowType            String
  level                   Int
  approverRoleId          String?
  approverUserIds         String[]
  autoApprove             Boolean              @default(false)
  autoApproveAfterMinutes Int?
  isRequired              Boolean              @default(true)
  slaMinutes              Int                  @default(1440)
  escalationMinutes       Int?
  isActive                Boolean              @default(true)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  TransportAccessRole     TransportAccessRole? @relation(fields: [approverRoleId], references: [id])
  Company                 Company              @relation(fields: [companyId], references: [id])

  @@unique([companyId, workflowType, level])
  @@index([companyId, workflowType])
}

model ApprovalWorkflow {
  id                  String    @id @default(uuid())
  companyId           String
  workflowType        String
  entityType          String
  entityId            String
  requestedBy         String
  requestedAt         DateTime  @default(now())
  currentApproverId   String?
  currentApproverRole String?
  status              String    @default("PENDING")
  priority            String    @default("NORMAL")
  escalationLevel     Int       @default(0)
  maxEscalationLevel  Int       @default(3)
  requestReason       String?
  comments            String?
  metadata            Json      @default("{}")
  decidedBy           String?
  decidedAt           DateTime?
  decision            String?
  decisionReason      String?
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([companyId, currentApproverId])
  @@index([companyId, requestedBy])
  @@index([companyId, status])
  @@index([companyId, workflowType, status])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String
  action       String
  entity       String
  entityId     String?
  oldValue     Json?
  newValue     Json?
  reason       String?
  ipAddress    String?
  createdAt    DateTime @default(now())
  companyId    String?
  details      Json?
  resourceId   String?
  resourceType String?
  User         User     @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([userId])
}

model BillingPricingRule {
  id                String            @id @default(uuid())
  companyId         String?
  planId            String?
  pricingModel      PricingModel
  currency          String
  rateValue         Int
  tierConfig        Json?
  includedAllowance Json?
  billingCycle      BillingCycle      @default(MONTHLY)
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  setByUserId       String
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  Company           Company?          @relation(fields: [companyId], references: [id])
  PlatformInvoice   PlatformInvoice[]

  @@index([companyId])
  @@index([planId])
  @@index([pricingModel])
}

model Boarding {
  id                              String         @id @default(uuid())
  tripId                          String
  passengerId                     String
  driverId                        String
  status                          BoardingAction @default(BOARD)
  method                          BoardingMethod @default(MANUAL)
  otp                             String?
  qrCode                          String?
  latitude                        Float?
  longitude                       Float?
  timestamp                       DateTime       @default(now())
  User_Boarding_driverIdToUser    User           @relation("Boarding_driverIdToUser", fields: [driverId], references: [id])
  User_Boarding_passengerIdToUser User           @relation("Boarding_passengerIdToUser", fields: [passengerId], references: [id])
  Trip                            Trip           @relation(fields: [tripId], references: [id])

  @@index([passengerId])
  @@index([tripId])
}

model BoardingVerification {
  id              String    @id @default(uuid())
  companyId       String
  tripId          String
  vehicleId       String
  driverId        String
  method          String    @default("MANUAL")
  expectedCount   Int       @default(0)
  verifiedCount   Int       @default(0)
  boardedCount    Int       @default(0)
  noShowCount     Int       @default(0)
  extraPassengers Int       @default(0)
  otpCode         String?
  otpVerified     Boolean   @default(false)
  otpExpiry       DateTime?
  status          String    @default("PENDING")
  discrepancyNote String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId])
  @@index([tripId])
}

model Booking {
  id                                 String             @id @default(uuid())
  bookingCode                        String             @unique
  type                               BookingType
  bookingMode                        BookingMode        @default(OWN)
  status                             BookingStatus      @default(REQUESTED)
  requesterId                        String
  managerBookerId                    String?
  passengerCount                     Int                @default(1)
  serviceType                        ServiceType
  routeId                            String?
  date                               DateTime           @db.Date
  pickupTime                         DateTime
  returnTrip                         Boolean            @default(false)
  returnTime                         DateTime?
  isRecurring                        Boolean            @default(false)
  recurrencePattern                  Json?
  pickupLatitude                     Float
  pickupLongitude                    Float
  pickupAddress                      String
  pickupLandmark                     String?
  pickupRadius                       Float?             @default(100)
  dropLatitude                       Float
  dropLongitude                      Float
  dropAddress                        String
  dropLandmark                       String?
  purpose                            String?
  department                         String?
  costCenter                         String?
  project                            String?
  specialRequirements                String?
  notes                              String?
  approvalStatus                     ApprovalStatus     @default(NOT_REQUIRED)
  approvedById                       String?
  approvedAt                         DateTime?
  rejectionReason                    String?
  cancelledAt                        DateTime?
  cancellationReason                 String?
  tripId                             String?
  companyId                          String
  siteId                             String?
  processId                          String?
  teamId                             String?
  costCenterId                       String?
  createdAt                          DateTime           @default(now())
  updatedAt                          DateTime           @updatedAt
  ApprovalEntry                      ApprovalEntry[]
  User_Booking_approvedByIdToUser    User?              @relation("Booking_approvedByIdToUser", fields: [approvedById], references: [id])
  Company                            Company            @relation(fields: [companyId], references: [id])
  User_Booking_managerBookerIdToUser User?              @relation("Booking_managerBookerIdToUser", fields: [managerBookerId], references: [id])
  User_Booking_requesterIdToUser     User               @relation("Booking_requesterIdToUser", fields: [requesterId], references: [id])
  Trip                               Trip?              @relation(fields: [tripId], references: [id])
  BookingPassenger                   BookingPassenger[]
  ShuttleBooking                     ShuttleBooking?

  @@index([companyId])
  @@index([date])
  @@index([requesterId])
  @@index([serviceType])
  @@index([status])
  @@index([tripId])
}

model BookingPassenger {
  id        String  @id @default(uuid())
  bookingId String
  userId    String
  Booking   Booking @relation(fields: [bookingId], references: [id])
  User      User    @relation(fields: [userId], references: [id])

  @@unique([bookingId, userId])
}

model BudgetAllocation {
  id              String   @id @default(uuid())
  companyId       String
  level           String
  levelId         String
  fiscalYear      String
  fiscalMonth     String?
  allocatedBudget Float
  spentAmount     Float    @default(0)
  reservedAmount  Float    @default(0)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, level, levelId, fiscalYear, fiscalMonth])
  @@index([companyId, level])
}

model BusinessUnit {
  id          String        @id @default(uuid())
  name        String
  companyId   String
  createdAt   DateTime      @default(now())
  Company     Company       @relation(fields: [companyId], references: [id])
  CompanySite CompanySite[]
  Department  Department[]
  User        User[]

  @@unique([companyId, name])
}

model CabApproval {
  id                String    @id @default(uuid())
  companyId         String
  vehicleId         String
  driverId          String?
  vendorId          String?
  requestType       String
  status            String    @default("PENDING")
  requestedBy       String
  requestedAt       DateTime  @default(now())
  reviewedBy        String?
  reviewedAt        DateTime?
  reviewNotes       String?
  complianceCheck   Boolean   @default(false)
  documentsVerified Boolean   @default(false)
  vehicleInspected  Boolean   @default(false)
  driverVerified    Boolean   @default(false)
  insuranceValid    Boolean   @default(false)
  pucValid          Boolean   @default(false)
  permitValid       Boolean   @default(false)
  fitnessValid      Boolean   @default(false)
  expiryDate        DateTime?
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([companyId, requestType])
  @@index([companyId, status])
  @@index([companyId, vehicleId])
}

model CabAvailability {
  id                String   @id @default(uuid())
  companyId         String
  siteId            String
  processId         String?
  shiftId           String?
  date              DateTime @db.Date
  timeSlot          String
  transportType     String
  vehicleType       String?
  capacity          Int
  isAC              Boolean  @default(true)
  vendorId          String?
  assignedDriverId  String?
  assignedVehicleId String?
  status            String   @default("AVAILABLE")
  totalBookings     Int      @default(0)
  maxBookings       Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  Company           Company  @relation(fields: [companyId], references: [id])

  @@index([companyId, siteId, date, timeSlot])
}

model CabCapacityConfig {
  id               String   @id @default(uuid())
  companyId        String
  configName       String
  vehicleType      String
  maxPassengers    Int
  allowMixedGender Boolean  @default(false)
  femaleOnlyCab    Boolean  @default(false)
  luxuryUpgrade    Boolean  @default(false)
  accessibility    Boolean  @default(false)
  acRequired       Boolean  @default(true)
  maxLuggageKg     Float?
  applicableShifts String?
  fareMultiplier   Float    @default(1.0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([companyId, vehicleType, configName])
  @@index([companyId, isActive])
}

model ClubbingConfig {
  id                  String   @id @default(uuid())
  companyId           String
  siteId              String?
  processId           String?
  policy              String   @default("SAME_PROCESS_ONLY")
  allowedCombinations Json?
  billingSeparation   Boolean  @default(true)
  safetyOverride      Boolean  @default(false)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  Company             Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, siteId, processId])
}

model CommunicationLog {
  id             String   @id @default(uuid())
  companyId      String
  channel        String
  recipientId    String?
  recipientPhone String?
  recipientEmail String?
  messageType    String
  templateId     String?
  content        String?
  tripId         String?
  vehicleId      String?
  driverId       String?
  status         String   @default("QUEUED")
  externalId     String?
  errorMessage   String?
  retryCount     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companyId, channel])
  @@index([messageType])
  @@index([recipientId])
  @@index([status])
}

model CommunicationPreference {
  id            String   @id @default(uuid())
  companyId     String
  userId        String
  whatsapp      Boolean  @default(true)
  sms           Boolean  @default(true)
  email         Boolean  @default(true)
  push          Boolean  @default(true)
  tripAssigned  String   @default("WHATSAPP")
  tripArriving  String   @default("WHATSAPP")
  tripCompleted String   @default("PUSH")
  emergency     String   @default("ALL")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, userId])
  @@index([companyId])
}

model Company {
  id                             String                           @id @default(uuid())
  name                           String
  legalName                      String?
  code                           String                           @unique
  slug                           String                           @unique
  domain                         String?
  logo                           String?
  favicon                        String?
  settings                       Json                             @default("{}")
  status                         CompanyStatus                    @default(DRAFT)
  contactEmail                   String?
  contactPhone                   String?
  country                        String?
  city                           String?
  timezone                       String?                          @default("Asia/Kolkata")
  currency                       String?                          @default("INR")
  distanceUnit                   String?                          @default("KM")
  gstin                          String?
  pan                            String?
  billingModel                   String?                          @default("COMPANY") // COMPANY | SITE | PROCESS
  billingCycle                   String?                          @default("MONTHLY") // MONTHLY | QUARTERLY
  primaryContactName             String?
  primaryContactEmail            String?
  primaryContactPhone            String?
  brandName                      String?
  primaryColor                   String?                          @default("#2563EB")
  secondaryColor                 String?                          @default("#1E40AF")
  customDomain                   String?
  domainStatus                   DomainStatus                     @default(NONE)
  domainVerifiedAt               DateTime?
  createdAt                      DateTime                         @default(now())
  updatedAt                      DateTime                         @updatedAt
  AccessScope                    AccessScope[]
  AdminDelegation                AdminDelegation[]
  AdminScopeAssignment           AdminScopeAssignment[]
  ApiKey                         ApiKey[]
  ApprovalLevelConfig            ApprovalLevelConfig[]
  BillingPricingRule             BillingPricingRule[]
  Booking                        Booking[]
  BusinessUnit                   BusinessUnit[]
  CabAvailability                CabAvailability[]
  ClubbingConfig                 ClubbingConfig[]
  CompanyMembership              CompanyMembership[]
  CompanySite                    CompanySite[]
  ComplianceAlert                ComplianceAlert[]
  ComplianceConfig               ComplianceConfig?
  ComplianceDocument             ComplianceDocument[]
  ComplianceRule                 ComplianceRule[]
  CostCenter                     CostCenter[]
  Department                     Department[]
  DispatchOptimizationRun        DispatchOptimizationRun[]
  DriverAreaPreference           DriverAreaPreference[]
  DriverAvailabilityEvent        DriverAvailabilityEvent[]
  DriverDevice                   DriverDevice[]
  DriverLocationPoint            DriverLocationPoint[]
  DriverOnboarding               DriverOnboarding[]
  DriverProfile                  DriverProfile[]
  DriverShiftAssignment          DriverShiftAssignment[]
  EmployeeOnboarding             EmployeeOnboarding[]
  EmployeeTransportStatusHistory EmployeeTransportStatusHistory[]
  FeatureFlag                    FeatureFlag[]
  Geofence                       Geofence[]
  Incident                       Incident[]
  LineOfBusiness                 LineOfBusiness[]
  OrgProcess                     OrgProcess[]
  PassengerMovement              PassengerMovement[]
  VehicleQR                      VehicleQR[]
  PlatformInvoice                PlatformInvoice[]
  ProductionFeature              ProductionFeature[]
  ProductionRelease              ProductionRelease[]
  RateCard                       RateCard[]
  Region                         Region[]
  RolePermissionConfig           RolePermissionConfig[]
  Route                          Route[]
  Shift                          Shift[]
  ShuttleAvailability            ShuttleAvailability[]
  Team                           Team[]
  TrainingSession                TrainingSession[]
  TransportPolicy                TransportPolicy[]
  TransportScheduleSlot          TransportScheduleSlot[]
  Trip                           Trip[]
  TripAssignmentHistory          TripAssignmentHistory[]
  UsageMeteringRecord            UsageMeteringRecord[]
  User                           User[]
  Vehicle                        Vehicle[]
  VehicleOnboarding              VehicleOnboarding[]
  Vendor                         Vendor[]
  VendorContract                 VendorContract[]
  VendorOnboarding               VendorOnboarding[]
  CompanyContact                 CompanyContact[]
  GPSLog                         GPSLog[]
  VehicleLocation                VehicleLocation[]
  SaaSInvoice                    SaaSInvoice[]
  TransportInvoice               TransportInvoice[]
  BillingReconciliation          BillingReconciliation[]
  ReportTemplate                 ReportTemplate[]
  ScheduledReport                ScheduledReport[]
  ReportExecution                ReportExecution[]
  employeeAddresses              EmployeeAddress[]
  nodalPoints                    NodalPoint[]
  employeeSchedules              EmployeeSchedule[]
  scheduleHistories              EmployeeScheduleHistory[]
  additionalPickupDrops          AdditionalPickupDrop[]
  pickupDropHistories            AdditionalPickupDropHistory[]
  employeeWeeklyOffs             EmployeeWeeklyOff[]
  employeeTeams                  EmployeeTeam[]
  teamMemberships                EmployeeTeamMember[]
  scheduleImportJobs             EmployeeScheduleImportJob[]
  vehicleTypes                   VehicleTypeRecord[]
  employeeHistories              EmployeeHistory[]
  shiftBufferPolicies            ShiftBufferPolicy[]
  timeSlotConfig                 TimeSlotConfig?
  transportScheduleConfig        TransportScheduleConfig?
  savingsTracker                 SavingsTracker[]
  optimizationSimulators         OptimizationSimulator[]
  costWaterfallEntries           CostWaterfallEntry[]
  vendorPerformanceScorecards    VendorPerformanceScorecard[]
  vehicleOccupancyLogs           VehicleOccupancyLog[]
  approvalRequests               ApprovalRequest[]
  locationChangeRequests         LocationChangeRequest[]
  permissionOverrides            UserAccessOverride[]          @relation("CompanyPermissionOverrides")
  permissionOverrideHistory      PermissionOverrideHistory[]   @relation("CompanyPermissionOverrideHistory")
  subscriptions                 Subscription[]
  webhooks                      WebhookConfig[]
  ssoConfigurations             SSOConfiguration[]
}

model CompanyComplianceDoc {
  id               String    @id @default(uuid())
  companyId        String
  entityType       String
  entityId         String
  documentTypeId   String
  documentType     String
  fileName         String
  fileUrl          String
  fileSize         Int?
  mimeType         String?
  documentNumber   String?
  issuedDate       DateTime?
  expiryDate       DateTime?
  issuingAuthority String?
  status           String    @default("PENDING")
  uploadedBy       String
  uploadedAt       DateTime  @default(now())
  reviewedBy       String?
  reviewedAt       DateTime?
  reviewNotes      String?
  rejectionReason  String?
  autoApproved     Boolean   @default(false)
  complianceScore  Float?
  metadata         Json      @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([companyId, documentType])
  @@index([companyId, entityType, entityId])
  @@index([companyId, expiryDate])
  @@index([companyId, status])
}

model CompanyComplianceStanding {
  id                   String    @id @default(uuid())
  companyId            String    @unique
  overallGrade         String    @default("A")
  overallScore         Float     @default(100)
  documentCompliance   Float     @default(100)
  vehicleCompliance    Float     @default(100)
  driverCompliance     Float     @default(100)
  vendorCompliance     Float     @default(100)
  totalDocuments       Int       @default(0)
  validDocuments       Int       @default(0)
  expiringDocuments    Int       @default(0)
  expiredDocuments     Int       @default(0)
  totalVehicles        Int       @default(0)
  compliantVehicles    Int       @default(0)
  totalDrivers         Int       @default(0)
  compliantDrivers     Int       @default(0)
  lastAuditDate        DateTime?
  lastAuditScore       Float?
  nextAuditDate        DateTime?
  suspensionRisk       Boolean   @default(false)
  suspensionRiskReason String?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([companyId, overallGrade])
  @@index([companyId, overallScore])
}

model CompanyDocumentType {
  id              String   @id @default(uuid())
  companyId       String
  documentType    String
  displayName     String
  description     String?
  isMandatory     Boolean  @default(true)
  forEntityType   String
  validityDays    Int?
  alertBeforeDays Int      @default(30)
  renewalRequired Boolean  @default(true)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, documentType, forEntityType])
  @@index([companyId, forEntityType])
}

model CompanyMembership {
  id          String           @id @default(uuid())
  userId      String
  companyId   String
  role        UserRole
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now())
  leftAt      DateTime?
  invitedById String?
  scope       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  company     Company          @relation(fields: [companyId], references: [id])
