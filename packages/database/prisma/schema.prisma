model SavingsTracker {
  id                   String   @id @default(uuid())
  optimizationCode     String   @unique
  companyId            String
  siteId               String?
  processId            String?
  status               String   @default("PROPOSED") // PROPOSED, APPROVED, IMPLEMENTED, REJECTED
  optimizationType     String   // ROUTE_MERGE, VEHICLE_REDUCTION, CLUBBING, SCHEDULE_CHANGE, VENDOR_SWITCH
  title                String
  description          String?
  beforeVehicles       Int      @default(0)
  afterVehicles        Int      @default(0)
  beforeTrips          Int      @default(0)
  afterTrips           Int      @default(0)
  beforeCostPerDay     Float    @default(0)
  afterCostPerDay      Float    @default(0)
  dailySaving          Float    @default(0)
  monthlyProjectedSaving Float  @default(0)
  actualSaving         Float    @default(0)
  affectedEmployees    Int      @default(0)
  affectedShifts       String?  // JSON array of shift codes
  reason               String?
  constraints          String?  // JSON: female safety, max capacity, route constraints, etc.
  proposedBy           String?
  approvedBy           String?
  implementedAt        DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  Company              Company  @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
  @@index([companyId, optimizationType])
}

