model Trip {
  id                  String             @id @default(uuid())
  tripCode            String             @unique
  status              TripStatus         @default(SCHEDULED)
  type                BookingType
  routeId             String?
  routePolyline       String?
  plannedPolyline     String?
  vehicleId           String?
  driverId            String?
  date                DateTime           @db.Date
  scheduledPickupTime DateTime
  actualPickupTime    DateTime?
  scheduledDropTime   DateTime?
  actualDropTime      DateTime?
  pickupLatitude      Float
  pickupLongitude     Float
  pickupAddress       String
  dropLatitude        Float
  dropLongitude       Float
  dropAddress         String
  distanceKm          Float?
  plannedDuration     Int?
  actualDuration      Int?
  estimatedCost       Float?
  actualCost          Float?
  passengerCount      Int                @default(0)
  boardedCount        Int                @default(0)
  noShowCount         Int                @default(0)
  isTracking          Boolean            @default(false)

  // Departure mode & early pickup
  departureMode       String             @default("FIXED")
  waitTimeoutMinutes  Int                @default(15)
  departureTriggered  Boolean            @default(false)
  targetArrivalTime   DateTime?
  originalShiftTime   String?

  startedAt           DateTime?
  completedAt         DateTime?
  companyId           String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  Boarding            Boarding[]
  Booking             Booking[]
  DriverTrip          DriverTrip?
  Incident            Incident[]
  LocationPing        LocationPing[]
  SOSAlert            SOSAlert[]
  Company             Company            @relation(fields: [companyId], references: [id])
  User                User?              @relation(fields: [driverId], references: [id])
  Route               Route?             @relation(fields: [routeId], references: [id])
  Vehicle             Vehicle?           @relation(fields: [vehicleId], references: [id])
  TripCost            TripCost[]
  TripCostSnapshot    TripCostSnapshot[]
  TripPassenger       TripPassenger[]
  VehicleOccupancyLog VehicleOccupancyLog[]

  @@index([companyId])
  @@index([date])
  @@index([driverId])
  @@index([routeId])
  @@index([status])
  @@index([vehicleId])
}

