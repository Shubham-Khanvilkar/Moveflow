{
  "expo": {
    "name": "NAVIRA",
    "slug": "navira-logistics",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.navira.logistics",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "NAVIRA needs camera access for document scanning",
        "NSLocationWhenInUseUsageDescription": "NAVIRA needs location for trip tracking",
        "NSLocationAlwaysUsageDescription": "NAVIRA needs background location for live tracking",
        "NSFaceIDUsageDescription": "NAVIRA uses Face ID for secure login"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      },
      "package": "com.navira.logistics",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow NAVIRA to use your location for trip tracking."
        }
      ],
      "expo-secure-store"
    ]
  }
}
