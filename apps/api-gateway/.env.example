# ============================================================
# API Gateway Environment Configuration
# ============================================================
# NOTE: This file is loaded from the root .env file.
# Keep this file for reference only. Edit ../.env for actual values.

# Application
PORT=3001
NODE_ENV=development

# Database (PostgreSQL via Prisma)
DATABASE_URL=postgresql://postgres:password@localhost:5432/moveflow

# Redis
REDIS_URL=redis://localhost:6379

# Supabase Auth (primary auth provider)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase

# Legacy JWT (for internal service-to-service auth)
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRATION=24h

# CORS
CORS_ORIGIN=http://localhost:3000

# External Services
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
STRIPE_SECRET_KEY=your-stripe-secret-key
SENDGRID_API_KEY=your-sendgrid-api-key
