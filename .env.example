# ============================================
# NAVIRA Platform - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values

# ============================================
# API Gateway
# ============================================
PORT=3001
NODE_ENV=development
API_PREFIX=api

# ============================================
# Database (PostgreSQL)
# ============================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/moveflow

# ============================================
# Redis
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# JWT Auth
# ============================================
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=24h

# ============================================
# Supabase (Auth + Realtime)
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Client-side (Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ============================================
# Google Maps APIs
# ============================================
# Required for: Places Autocomplete, Directions, Distance Matrix
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Client-side (Next.js)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ============================================
# Mapbox (Live Tracking Map)
# ============================================
# Required for: Real-time vehicle tracking, geofences, route visualization
MAPBOX_ACCESS_TOKEN=pk.eyJ1Ijoi...your-token

# Client-side (Next.js)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ1Ijoi...your-token

# ============================================
# Web App
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_DEMO_PASSWORD=
